{
  "name": "gestion-tournois-src",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/socket.io/*"
    ]
  },
  "main": "cloudflare/worker.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "TournamentRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "online-v1",
      "new_sqlite_classes": [
        "TournamentRoom"
      ]
    }
  ]
}
